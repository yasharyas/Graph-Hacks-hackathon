# Copy to .env and fill in. Never commit .env.
PORT=8080

# FalkorDB (inside the container it is bound to 127.0.0.1)
FALKOR_HOST=127.0.0.1
FALKOR_PORT=6379
REDIS_PASSWORD=change-me
PZ_RO_PASSWORD=change-me-ro
PZ_RW_PASSWORD=change-me-rw

# Free-tier LLMs (OpenAI-compatible). Order = fallback order.
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_CHAIN=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite,replay
LLM_DAILY_CAP=800

# Fine-grained GitHub token, public repositories read-only. Optional (60 req/h without it).
GH_TOKEN=

# Per-provider timeout (ms) before falling back to the next one.
LLM_TIMEOUT_MS=15000
