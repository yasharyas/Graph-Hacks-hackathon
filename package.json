{
  "name": "patient-zero",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.ts",
    "start": "node server/index.ts",
    "build:web": "vite build",
    "build:graph": "node --env-file-if-exists=.env server/ingest/build.ts",
    "triage": "node --env-file-if-exists=.env server/agent/triage.ts",
    "mcp": "node --env-file-if-exists=.env server/mcp.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite",
    "fonts": "node web/src/design/fetch-fonts.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "falkordb": "6.8.0",
    "hono": "4.13.13",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "motion": "14.0.0",
    "p5": "2.3.4",
    "p5.brush": "2.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-2d": "1.29.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
